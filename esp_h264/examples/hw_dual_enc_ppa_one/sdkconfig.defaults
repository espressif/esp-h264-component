CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_EXAMPLE_SRC_WIDTH=1920
CONFIG_EXAMPLE_SRC_HEIGHT=1088
CONFIG_EXAMPLE_PPA_SCALE_NUM=1
CONFIG_EXAMPLE_PPA_SCALE_DEN=2
CONFIG_EXAMPLE_ENC_FPS=30
CONFIG_EXAMPLE_ENC_GOP=30
CONFIG_EXAMPLE_RUN_SECONDS=8
