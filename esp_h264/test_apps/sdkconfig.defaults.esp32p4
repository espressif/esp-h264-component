#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

#
# Compiler options
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y

#
# ESP PSRAM
#
CONFIG_SPIRAM=y

#
# PSRAM config
#
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_BOOT_INIT=y

#
# ESP System Settings
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360

#
# Cache config
#
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_CACHE_L2_CACHE_LINE_SIZE=128

#
# Kernel
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

#
# ESP H264 Configuration
#
CONFIG_ESP_H264_DECODER_IRAM=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

#
# Chip revision (CI GX64-P4 runners use ESP32-P4 ECO5, rev v3.1+)
#
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y

#
# Console: CI runners connect via USB Serial/JTAG (/dev/ttyACM*).
# Without this, the app console is on GPIO 38/37 (UART) while pytest-embedded
# writes to ttyACM1 → the Unity rx buffer never drains → SerialTimeoutException.
#
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

#
# Partition table offset: IDF master bootloader for P4 exceeds the default
# 0x6000-byte window (partition table at 0x8000). Move table to 0xa000 to
# give the bootloader 32 KB of headroom, compatible with IDF 5.5 and master.
#
CONFIG_PARTITION_TABLE_OFFSET=0xa000
